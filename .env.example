# 服务端口（默认 3000）
PORT=3000

# 签名登录 cookie 的密钥，生产环境请换成足够长的随机字符串
JWT_SECRET=please-change-me-to-a-long-random-string

# 可选。生产环境若前后端不同源，填写前端来源，例如 https://example.com
# 留空则允许同机开发地址
CORS_ORIGIN=

# cookie 有效期（天）
SESSION_DAYS=30

# HTTPS 部署时设为 1（cookie 带 Secure）；本地 HTTP 保持 0 或不设置
# COOKIE_SECURE=1

# 可选。设置后用户与标注存到 PostgreSQL（云端持久化），不设置则用本地 SQLite
# DATABASE_URL=postgres://user:password@host:5432/dbname
